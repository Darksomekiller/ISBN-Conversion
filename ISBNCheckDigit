#Function to calculate check digit of a singular 12-Digit ISBN number
def CheckDigitCalc(Isbn12):
    checkDigit=0
    tripleValue=False#boolean because its every second digit
    Weight=3
    for i in range(len(Isbn12)):
        var = int(Isbn12[i])
        if tripleValue:#for every second digit
            ISBNTriple=var
            ISBNTriple*=Weight
            checkDigit+=ISBNTriple
            tripleValue=False#to go back to weight of 1/first digit
        else:#for first digit 
            tripleValue=True#for next loop which is 2nd digit and gain weight of 3
            checkDigit+=var
    checkDigit=checkDigit%10
    checkDigit = 10-checkDigit
    if checkDigit == 10:
        return str(0)
    else:
        return str(checkDigit)#string so that it can be used in main function to concatenate

#ISBN12_LIST Procedure to find check digit of all items in list and make a list of 13-Digit numbers
def ISBN12_ListConversion(Isbn12,CheckDigitFunc):
    Isbn13=[]#new list of 13-digit
    for i in range(len(Isbn12)):
        IsbnIncomplete=Isbn12[i]
        Isbn13.append(IsbnIncomplete+"-"+CheckDigitFunc(Isbn12[i]))#puts 12 digit and check digit together
    return Isbn13
